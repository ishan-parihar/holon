__pycache__/
*.pyc
*.egg-info/
build/
dist/
.ruff_cache/
# instance state never lives in the distribution
*.db
*.db-wal
*.db-shm

# kb flock artifacts (the KB's own per-slug lock; never `*.lock`, which would swallow
# Cargo.lock and uv.lock if a vendored crate ever lands here)
.*.lock

# genome runtime state (locks, temp files, recon tokens, read marks)
*.genome-lock
*.genome-tmp
.genome/

# Holon ⇄ Notion sync: webhook receiver, push every 20 s, reconcile every 5 min.
# Install: cp to ~/.config/systemd/user/, adjust paths, `systemctl --user enable --now holon-notion`.
[Unit]
Description=Holon to Notion mirror
After=network-online.target

[Service]
Environment=HOLON_HOME=%h/holon
ExecStart=/usr/bin/env python3 %h/src/holon/adapters/notion/holon_notion.py serve --port 8787
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target

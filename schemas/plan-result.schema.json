{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holon:plan-result",
  "title": "Holon plan result",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "plan"
          ]
        },
        "findings": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": [
                  "string",
                  "object"
                ]
              }
            }
          ]
        },
        "writes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "external_effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grade": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "string",
              "pattern": "^[Gg]?[0-4]$"
            }
          ]
        },
        "assignee": {
          "type": "string"
        },
        "risks": {
          "type": "string"
        },
        "rollback": {
          "type": "string"
        },
        "estimate": {
          "type": "string"
        },
        "acceptance": {
          "type": "string"
        },
        "context_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learnings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "decision",
                      "constraint",
                      "preference",
                      "lesson",
                      "open_question",
                      "glossary",
                      "artifact"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            ]
          },
          "description": "lessons (your memory) and facts (the project's)"
        },
        "decisions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "decision",
                      "constraint",
                      "preference",
                      "lesson",
                      "open_question",
                      "glossary",
                      "artifact"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            ]
          },
          "description": "decisions future work must respect"
        },
        "proposals": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "intent"
                ]
              }
            ]
          },
          "description": "improvements, routed to the steward"
        }
      },
      "required": [
        "kind",
        "findings",
        "steps"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "decompose"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "grade": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            {
              "type": "string",
              "pattern": "^[Gg]?[0-4]$"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "type": "string"
              },
              "dept": {
                "type": "string"
              },
              "task_class": {
                "type": "string"
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4
              },
              "assignee": {
                "type": "string"
              },
              "risk": {
                "type": "string",
                "enum": [
                  "low",
                  "normal",
                  "high",
                  "irreversible"
                ]
              },
              "workdir": {
                "type": "string"
              },
              "after": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "lane": {
                "type": "string",
                "enum": [
                  "fast",
                  "full"
                ],
                "description": "fast: one session plans and acts; the kernel allows it only when the child's grade floor is G0"
              }
            },
            "required": [
              "title",
              "intent"
            ]
          },
          "minItems": 2
        },
        "learnings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "decision",
                      "constraint",
                      "preference",
                      "lesson",
                      "open_question",
                      "glossary",
                      "artifact"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            ]
          },
          "description": "lessons (your memory) and facts (the project's)"
        },
        "decisions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "decision",
                      "constraint",
                      "preference",
                      "lesson",
                      "open_question",
                      "glossary",
                      "artifact"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            ]
          },
          "description": "decisions future work must respect"
        },
        "proposals": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "intent"
                ]
              }
            ]
          },
          "description": "improvements, routed to the steward"
        }
      },
      "required": [
        "kind",
        "rationale",
        "children"
      ]
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "needs_input"
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "one question with options and your recommendation"
        },
        "learnings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "decision",
                      "constraint",
                      "preference",
                      "lesson",
                      "open_question",
                      "glossary",
                      "artifact"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            ]
          },
          "description": "lessons (your memory) and facts (the project's)"
        },
        "decisions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fact",
                      "decision",
                      "constraint",
                      "preference",
                      "lesson",
                      "open_question",
                      "glossary",
                      "artifact"
                    ]
                  },
                  "confidence": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  }
                },
                "required": [
                  "content"
                ]
              }
            ]
          },
          "description": "decisions future work must respect"
        },
        "proposals": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "intent": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "title",
                  "intent"
                ]
              }
            ]
          },
          "description": "improvements, routed to the steward"
        }
      },
      "required": [
        "kind",
        "question"
      ]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Holon executor result",
  "type": "object",
  "required": [
    "outcome",
    "summary",
    "documentation"
  ],
  "properties": {
    "outcome": {
      "enum": [
        "success",
        "partial",
        "failure",
        "noop"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "documentation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "artifacts": {
      "type": "array"
    },
    "learnings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "fact",
                  "decision",
                  "constraint",
                  "preference",
                  "lesson",
                  "open_question",
                  "glossary",
                  "artifact"
                ]
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "required": [
              "content"
            ],
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "fact",
                  "decision",
                  "constraint",
                  "preference",
                  "lesson",
                  "open_question",
                  "glossary",
                  "artifact"
                ]
              },
              "confidence": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            }
          }
        ]
      }
    },
    "blockers": {
      "type": "array"
    },
    "proposals": {
      "type": "array"
    },
    "next_intent": {
      "type": "string"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "holon:execute-result",
  "title": "Holon execute result",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failure",
        "noop"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "documentation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200000
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_intent": {
      "type": "string"
    },
    "learnings": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "decision",
                  "constraint",
                  "preference",
                  "lesson",
                  "open_question",
                  "glossary",
                  "artifact"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "required": [
              "content"
            ]
          }
        ]
      },
      "description": "lessons (your memory) and facts (the project's)"
    },
    "decisions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "content": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fact",
                  "decision",
                  "constraint",
                  "preference",
                  "lesson",
                  "open_question",
                  "glossary",
                  "artifact"
                ]
              },
              "confidence": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              }
            },
            "required": [
              "content"
            ]
          }
        ]
      },
      "description": "decisions future work must respect"
    },
    "proposals": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "intent": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "title",
              "intent"
            ]
          }
        ]
      },
      "description": "improvements, routed to the steward"
    }
  },
  "required": [
    "outcome",
    "summary",
    "documentation"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Holon reviewer result",
  "type": "object",
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "enum": [
        "approve",
        "reject"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "if": {
    "properties": {
      "decision": {
        "const": "reject"
      }
    }
  },
  "then": {
    "required": [
      "decision",
      "note"
    ],
    "properties": {
      "note": {
        "minLength": 1
      }
    }
  }
}

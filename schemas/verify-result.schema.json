{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Holon verifier result",
  "type": "object",
  "required": [
    "verdict",
    "note"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "pass",
        "fail"
      ]
    },
    "note": {
      "type": "string",
      "minLength": 1
    }
  }
}
